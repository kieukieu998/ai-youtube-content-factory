# ==========================================
# ỨNG DỤNG & CƠ SỞ DỮ LIỆU
# ==========================================
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
SECRET_KEY=change_this_to_a_random_secret_key
DATABASE_URL=sqlite:///./data/movie_ai.db

# ==========================================
# CẤU HÌNH AI PROVIDERS (MẶC ĐỊNH: GEMINI FREE)
# ==========================================
DEFAULT_AI_PROVIDER=gemini_free

# Google Gemini API Key (Miễn phí 100% tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API (Mở rộng sau này)
DEEPSEEK_API_KEY=

# OpenAI API (Mở rộng sau này)
OPENAI_API_KEY=

# Anthropic Claude API (Mở rộng sau này)
ANTHROPIC_API_KEY=

# ==========================================
# CẤU HÌNH TTS & SUBTITLE
# ==========================================
# Mặc định: vi-VN-HoaiMyNeural (Nữ) hoặc vi-VN-NamMinhNeural (Nam)
DEFAULT_TTS_VOICE=vi-VN-HoaiMyNeural
DEFAULT_TTS_SPEED=1.0

# ==========================================
# CẤU HÌNH ĐƯỜNG DẪN FFMPEG (NẾU KHÔNG CÓ TRONG SYSTEM PATH)
# ==========================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ==========================================
# TIKTOK PUBLISHING API
# ==========================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/publishing/tiktok/callback

# ==========================================
# THÔNG BÁO & AN TOÀN (TÙY CHỌN)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_BUDGET_LIMIT_USD=0.0
